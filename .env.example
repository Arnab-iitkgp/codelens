# Database
DATABASE_URL="postgresql://user:password@host/dbname"
BETTER_AUTH_SECRET="your_secret_here"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# Pinecone Vector DB
PINECONE_DB_API_KEY="your_pinecone_api_key"
# The index dimension must match your embedding model's output
# (gemini-embedding-001 = 3072 native). Changing embedding model = new index + full re-index.
PINECONE_INDEX_NAME="codelens-vector-embedding-v3"

# Monetization (Polar)
POLAR_ACCESS_TOKEN="your_polar_token"
POLAR_SUCCESS_URL="http://localhost:3000/dashboard"
POLAR_WEBHOOK_SECRET="your_polar_webhook_secret"

# ==========================================
# 🤖 AI Model Routing — per-role chains (D-018)
# ==========================================
# Each chain is an ordered list of "door:model" pairs. The first layer that
# responds serves the call; the rest are failover. A "door" is the credential
# path used to reach a model — Vertex (service-account JSON) and AI Studio
# (API key) are two doors to the same Google models.
#
#   doors: google-vertex | google-api | groq | openai
#          (embedding also accepts: huggingface)
#
# A malformed entry throws at startup rather than silently substituting a
# default model — that is how a fallback layer used to end up on flash-lite
# and llama-3.1-8b-instant unnoticed.

# Bulk PR review — high volume, so put the cheap model first.
AI_REVIEW_CHAIN="groq:openai/gpt-oss-120b,google-vertex:gemini-3.1-flash-lite-preview,google-api:gemini-3.1-flash-lite-preview"

# Auto-Fix agent — needs the strongest reachable model. Fails over per run.
AI_AGENT_CHAIN="google-vertex:gemini-3.1-pro-preview,groq:openai/gpt-oss-120b"

# Embeddings — EVERY layer must name the SAME model. Vectors from different
# models are not comparable, so switching model is a re-index, not a failover.
# gemini-embedding-001 is the only ID that resolves on BOTH Google doors,
# which is what makes this failover safe.
AI_EMBEDDING_CHAIN="google-vertex:gemini-embedding-001,google-api:gemini-embedding-001"

# Provider Keys
GOOGLE_GENERATIVE_AI_API_KEY="your_google_key"
# Optional: comma-separated keys are rotated round-robin. Note Google applies
# rate limits per PROJECT, so extra keys in the same project add no quota.
GOOGLE_GENERATIVE_AI_API_KEYS=""
OPENAI_API_KEY="your_openai_key"
GROQ_API_KEY="your_groq_key"
HUGGINGFACE_API_KEY="your_hf_key"

# Minified Service Account JSON string for Vertex AI — required by the
# google-vertex door. (In Vercel, minify vertex-key.json to a single line.)
GOOGLE_VERTEX_CREDENTIALS_JSON=""

# Collapse every chain to its first layer (no failover). Debugging aid.
DISABLE_CIRCUIT_BREAKER="false"

# ── Legacy (deprecated) ────────────────────────────────────────────
# Used ONLY when the matching AI_*_CHAIN above is unset, to derive an
# equivalent chain so old deployments keep working. Prefer the chains.
#   AI_PROVIDER / AI_MODEL_ID              -> AI_REVIEW_CHAIN
#   AI_AGENT_MODEL / AI_AGENT_MODEL_ID     -> AI_AGENT_CHAIN
#   AI_EMBEDDING_PROVIDER / ..._MODEL_ID   -> AI_EMBEDDING_CHAIN
#   GCP_ENABLED                            -> the door name is the switch

# Admin & Demo
DEMO_GITHUB_TOKEN="your_demo_token"
DEMO_GITHUB_OWNER="codelenshq"
DEMO_GITHUB_REPO="playground"
ADMIN_SECRET="your_admin_secret"
