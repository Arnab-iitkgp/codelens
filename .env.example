# Database
DATABASE_URL="postgresql://user:password@host/dbname"
BETTER_AUTH_SECRET="your_secret_here"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# Pinecone Vector DB
PINECONE_DB_API_KEY="your_pinecone_api_key"
PINECONE_INDEX_NAME="codelens-vector-embedding-v2"

# Monetization (Polar)
POLAR_ACCESS_TOKEN="your_polar_token"
POLAR_SUCCESS_URL="http://localhost:3000/dashboard"
POLAR_WEBHOOK_SECRET="your_polar_webhook_secret"

# ==========================================
# 🤖 AI Configuration (The Critic / Reviewer)
# ==========================================
AI_PROVIDER="google" # google, groq, openai
AI_MODEL_ID="gemini-3.5-flash"
AI_EMBEDDING_PROVIDER="google"
AI_EMBEDDING_MODEL_ID="text-embedding-004"

# Provider Keys
GOOGLE_GENERATIVE_AI_API_KEY="your_google_key"
OPENAI_API_KEY="your_openai_key"
GROQ_API_KEY="your_groq_key"
HUGGINGFACE_API_KEY="your_hf_key"

# ==========================================
# 🧠 Agent & Split-Brain Configuration (Auto-Fix)
# ==========================================
# Set to true to route through Vertex AI (Enterprise) instead of standard API keys
GCP_ENABLED="false"

# Minified Service Account JSON string for Vertex AI
# (In Vercel, minify your vertex-key.json to a single line and paste it here)
GOOGLE_VERTEX_CREDENTIALS_JSON=""

# The high-intelligence model specifically for the Auto-Fix Agent
AI_AGENT_MODEL_ID="gemini-3.1-pro-preview"

# Admin & Demo
DEMO_GITHUB_TOKEN="your_demo_token"
DEMO_GITHUB_OWNER="codelenshq"
DEMO_GITHUB_REPO="playground"
ADMIN_SECRET="your_admin_secret"
