# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

*PLAN.md
*key.json
# eval run outputs — one directory per run, potentially large
/eval/results/

# scratch and local test scripts
/scratch/
create_repo.ts
get_user.ts
test_api.ts
test_json.ts
trigger_index.*

# video render scratch
/video/frames*/
/video/test-frames/
/video/original/
video/*.wav
video/*.mp4
